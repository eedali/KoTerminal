{
    "name": "koterminal",
    "version": "1.0.0",
    "private": true,
    "description": "KoTerminal: a real terminal panel for KoBar (xterm.js plugin + local bridge).",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "test": "vitest run",
        "test:bridge": "npm --prefix bridge test",
        "package": "node scripts/package.mjs",
        "check": "npm run build && npm test && npm run test:bridge"
    },
    "devDependencies": {
        "@xterm/addon-fit": "0.10.0",
        "@xterm/xterm": "5.5.0",
        "fflate": "^0.8.3",
        "jsdom": "^28.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vite": "^7.3.1",
        "vitest": "^5.0.3"
    }
}
